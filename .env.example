# Copie este archivo como .env.local y complete la contraseña.

# Gateway del backend (nginx de la VPS).
VITE_API_BASE_URL=https://cruzdelnorte.duckdns.org

# Cuenta de servicio con la que la web se conecta al backend (rol VENTAS).
# Hoy es la única forma de leer viajes y vender con el backend actual.
# No suba la contraseña al repo (.env.local ya está en .gitignore).
# `npm run build` falla mientras esté configurada: no se puede publicar así,
# porque el token permite leer los datos de todos los pasajeros.
VITE_API_USUARIO=ventas
VITE_API_PASSWORD=
