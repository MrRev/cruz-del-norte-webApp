# URL del gateway del backend (nginx de la VPS). Para un backend local: http://localhost:8080
VITE_API_BASE_URL=https://cruzdelnorte.duckdns.org

# true: datos de ejemplo sin backend (permite buscar, pero no comprar).
# false: usa el backend real.
VITE_USE_MOCKS=true

# SOLO PRUEBAS LOCALES. Con VITE_USE_MOCKS=false, la web inicia sesión por detrás
# con una cuenta de VENTAS para usar los endpoints actuales y completar la compra.
# El build de producción falla si esto está en true: el token permitiría leer los
# datos de todos los pasajeros. Pida la contraseña al equipo; no la suba al repo.
VITE_DEMO_VENTAS=false
VITE_DEMO_USUARIO=ventas
VITE_DEMO_PASSWORD=
