# Variables del SERVIDOR (funciones de la carpeta api/).
# En tu PC: copia este archivo como .env.local. En Vercel: Settings → Environment Variables.
# No uses el prefijo VITE_: esas variables se copian al JavaScript público.

# Gateway del backend (nginx de la VPS).
API_BASE_URL=https://cruzdelnorte.duckdns.org

# Cuenta de servicio con la que el servidor se conecta al backend (rol VENTAS).
API_USUARIO=ventas
API_PASSWORD=

# Firma los tokens de compra (uno por asiento retenido). Cadena aleatoria de
# 32+ caracteres. Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PURCHASE_TOKEN_SECRET=

# Opcional: consulta de nombres por DNI (apiperu.pe). Sin token, el cliente
# escribe nombres y apellidos a mano.
DNI_API_URL=https://api.apiperu.pe
DNI_API_TOKEN=
DNI_API_KEY=
